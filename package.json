{
  "name": "gozmacerasi",
  "version": "0.3.0",
  "description": "Gözmacerasi - Amblyopia & Strabismus Therapy Platform (CodeV3)",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "packages/*",
    "packages/shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "cd packages/backend && npm run db:generate",
    "db:migrate": "cd packages/backend && npm run db:migrate",
    "db:migrate:deploy": "cd packages/backend && npm run db:migrate:deploy",
    "db:seed": "cd packages/backend && npm run db:seed",
    "db:reset": "cd packages/backend && npm run db:reset",
    "db:studio": "cd packages/backend && npx prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=11.0.0"
  }
}
